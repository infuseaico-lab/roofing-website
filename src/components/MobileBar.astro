---
import Icon from './Icon.astro';
import { telHref } from '../data/site';
---

<div class="mobile-bar" aria-label="Quick contact">
  <a class="btn btn--ghost" href={telHref}><Icon name="phone" /> Call</a>
  <a class="btn btn--primary" href="/contact/">Free estimate</a>
</div>

<style>
  .mobile-bar {
    display: none;
  }

  @media (max-width: 760px) {
    .mobile-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 0.6rem;
      padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
      background: var(--white);
      border-top: 1px solid var(--line);
      box-shadow: 0 -8px 24px -16px rgb(0 0 0 / 0.35);
    }

    .mobile-bar .btn {
      min-height: 3rem;
      background-color: var(--btn-bg);
    }

    .mobile-bar .btn--ghost {
      --btn-bg: var(--white);
    }

    :global(body) {
      padding-bottom: calc(4.4rem + env(safe-area-inset-bottom));
    }
  }
</style>
