---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { telHref } from '../data/site';
---

<Base title="Page not found" description="This page doesn’t exist.">
  <section class="section">
    <div class="wrap nf">
      <h1>That page slipped off the roof.</h1>
      <p class="lede">The link may be old or mistyped. Here’s where most people are headed:</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href="/contact/">Get a free estimate <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href={telHref}><Icon name="phone" /> Call us</a>
        <a class="link-arrow" href="/">Back to the homepage <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    min-height: 45vh;
    align-content: center;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }
</style>
