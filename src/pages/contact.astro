---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Fill from '../components/Fill.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { business, telHref } from '../data/site';
---

<Base
  title="Free Roof Estimate & Contact"
  description="Request a free roof estimate, call us, or book an inspection online. Family-owned roofing for Los Angeles and Orange County."
>
  <PageHero
    crumb="Contact"
    title="Get your free estimate."
    lede="Three ways to reach us. Whichever you pick, the inspection and written estimate are free."
  />

  <section class="section contact">
    <div class="wrap contact__grid">
      <EstimateForm id="estimate-main" heading="Request a free estimate" />

      <div class="contact__side">
        <section class="way" aria-labelledby="call-h">
          <Icon name="phone" />
          <div>
            <h2 id="call-h">Call us</h2>
            <p class="way__big"><a href={telHref}><Fill value={business.phone} label="(000) 000-0000" /></a></p>
            <p><Fill value={business.hours} label="Business hours" /></p>
            <p class="way__urgent">
              Active leak? Call right away. <Fill value={business.emergencyHours} label="Emergency hours" />
            </p>
          </div>
        </section>

        <section class="way" id="book" aria-labelledby="book-h">
          <Icon name="calendar" />
          <div>
            <h2 id="book-h">Book an inspection online</h2>
            {
              business.bookingUrl ? (
                <Fragment>
                  <p>Pick a time that works for you. We’ll confirm by phone or text.</p>
                  <a class="btn btn--ghost" href={business.bookingUrl} rel="noopener">
                    Choose a time <Icon name="arrow-right" />
                  </a>
                </Fragment>
              ) : (
                <p>
                  <span class="ph">Booking link</span> Add your scheduling link (Calendly, Jobber, Housecall Pro...) as{' '}
                  <code>bookingUrl</code> in src/data/site.ts and a “Choose a time” button appears here.
                </p>
              )
            }
          </div>
        </section>

        <section class="way" aria-labelledby="visit-h">
          <Icon name="map-pin" />
          <div>
            <h2 id="visit-h">Office</h2>
            <p><Fill value={business.address} label="Business address" /></p>
            <p>
              {business.email ? <a href={`mailto:${business.email}`}>{business.email}</a> : <Fill label="Email" />}
            </p>
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__side {
    display: grid;
    gap: 0;
  }

  .way {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .way:first-child {
    padding-top: 0.5rem;
  }

  .way > :global(svg) {
    width: 3rem;
    height: 3rem;
    padding: 0.7rem;
    border-radius: 50%;
    background: var(--slate);
    color: var(--amber);
  }

  .way > div {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .way h2 {
    font-size: 1.45rem;
  }

  .way__big {
    font-family: var(--font-display);
    font-weight: 780;
    font-size: 1.9rem;
    font-variant-numeric: tabular-nums;
  }

  .way__big a {
    text-decoration: none;
    color: var(--ink);
  }

  .way__urgent {
    font-weight: 600;
  }

  code {
    font-size: 0.9em;
    background: var(--slate-tint);
    padding: 0.05em 0.3em;
    border-radius: 3px;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
